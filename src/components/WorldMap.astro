---
// Static world map rendered at build time: no tiles, no tracking, no client JavaScript.
import { geoEqualEarth, geoPath, geoCentroid } from 'd3-geo';
import { feature } from 'topojson-client';
import world from 'world-atlas/countries-110m.json';
import type { Incident } from '../lib/incidents';
import { riskTypeOf } from '../data/taxonomy';
import { COUNTRIES, countryName } from '../data/countries';

interface Props { incidents: Incident[] }
const { incidents } = Astro.props;

const W = 960, H = 470;
// @ts-ignore topojson typing
const land = feature(world, world.objects.countries) as any;
const features = land.features.filter((f: any) => f.properties?.name !== 'Antarctica');
const projection = geoEqualEarth().fitExtent([[8, 8], [W - 8, H - 8]], { type: 'FeatureCollection', features } as any);
const path = geoPath(projection);

const byNumeric = new Map(features.map((f: any) => [String(f.id).padStart(3, '0'), f]));
const touched = new Set(incidents.flatMap((i) => i.data.countries.map((c) => COUNTRIES[c]?.numeric)).filter(Boolean));

// Small manual nudges where a centroid falls badly (e.g. USA pulled toward Alaska, France toward overseas territories).
const ANCHORS: Record<string, [number, number]> = { USA: [-98, 39], FRA: [2.3, 46.6], NOR: [9, 61], RUS: [60, 57], CAN: [-100, 56] };

function anchor(a3: string): [number, number] | null {
  if (ANCHORS[a3]) return projection(ANCHORS[a3]) as [number, number];
  const f = byNumeric.get(COUNTRIES[a3]?.numeric ?? '');
  if (!f) return null;
  return projection(geoCentroid(f)) as [number, number];
}

const placed = new Map<string, number>();
const markers = incidents.flatMap((i) =>
  i.data.countries.filter((c) => c !== 'WLD').map((c) => {
    const p = anchor(c);
    if (!p) return null;
    const k = placed.get(c) ?? 0;
    placed.set(c, k + 1);
    const angle = k * 2.4;
    const r = k === 0 ? 0 : 9 + k * 2;
    return { incident: i, country: c, x: p[0] + Math.cos(angle) * r, y: p[1] + Math.sin(angle) * r, risk: riskTypeOf(i.data.risk.primary).code };
  }).filter(Boolean),
) as { incident: Incident; country: string; x: number; y: number; risk: string }[];

// Arcs connect the countries involved in one incident (along a great circle).
const arcs = incidents.filter((i) => i.data.countries.filter((c) => c !== 'WLD').length > 1).flatMap((i) => {
  const cs = i.data.countries.filter((c) => c !== 'WLD');
  const pts = cs.map((c) => (ANCHORS[c] ? ANCHORS[c] : (() => { const f = byNumeric.get(COUNTRIES[c]?.numeric ?? ''); return f ? geoCentroid(f) : null; })())).filter(Boolean) as [number, number][];
  return pts.slice(1).map((p) => ({ d: path({ type: 'LineString', coordinates: [pts[0], p] } as any), risk: riskTypeOf(i.data.risk.primary).code }));
});
---
<figure class="map">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby="map-title map-desc">
    <title id="map-title">World map of recorded incidents</title>
    <desc id="map-desc">{incidents.length} incident{incidents.length === 1 ? '' : 's'} recorded, involving {[...new Set(incidents.flatMap((i) => i.data.countries))].map(countryName).join(', ') || 'no countries yet'}.</desc>
    <g class="countries">
      {features.map((f: any) => (
        <path d={path(f)} class:list={[{ touched: touched.has(String(f.id).padStart(3, '0')) }]} />
      ))}
    </g>
    <g class="arcs" aria-hidden="true">
      {arcs.map((a) => <path d={a.d} data-risk={a.risk} />)}
    </g>
    <g class="markers">
      {markers.map((m) => (
        <a href={`/incidents/${m.incident.id}/`} data-risk={m.risk}>
          <title>{m.incident.data.title} ({countryName(m.country)})</title>
          <circle class="halo" cx={m.x} cy={m.y} r="16" />
          <circle class="core" cx={m.x} cy={m.y} r="6.5" />
        </a>
      ))}
    </g>
  </svg>
</figure>

<style>
  .map { margin: 0; }
  svg { display: block; width: 100%; height: auto; }
  .countries path { fill: var(--land); stroke: var(--land-line); stroke-width: 0.5; }
  .countries path.touched { fill: #2f466e; stroke: #4a6593; }
  .arcs path { fill: none; stroke: var(--risk); stroke-width: 1.2; stroke-dasharray: 3 4; opacity: 0.8; }
  .markers .core { fill: var(--risk); stroke: var(--bg); stroke-width: 1.5; }
  .markers .halo { fill: var(--risk); opacity: 0.16; transform-box: fill-box; transform-origin: center; animation: beacon 3.2s ease-out infinite; }
  .markers a:hover .core, .markers a:focus-visible .core { stroke: var(--text); }
  @keyframes beacon { 0% { transform: scale(0.6); opacity: 0.35; } 100% { transform: scale(1.6); opacity: 0; } }
</style>
